root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.spec]
indent_size = unset
indent_style = unset

[*.patch]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[incus-shutdown]
indent_size = 4
